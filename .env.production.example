APP_NAME=Mauricare
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://mauricare.mu
APP_TIMEZONE=Indian/Mauritius
TRUSTED_PROXIES=*

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=mauricar_mcare
DB_USERNAME=mauricar_mcare
DB_PASSWORD=REPLACE_WITH_A_STRONG_DATABASE_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.mauricare.mu
MAIL_PORT=465
MAIL_USERNAME=contact@mauricare.mu
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="contact@mauricare.mu"
MAIL_FROM_NAME="${APP_NAME}"
PUBLIC_CONTACT_MAIL_TO="info@mauricare.mu"
SUPPORT_CONTACT_MAIL_TO="contact@mauricare.mu"
ADMIN_MESSAGE_NOTIFICATION_TO="admin@mauricare.mu"

PRIVACY_NOTICE_VERSION=2026-08-03
PRIVACY_CONTROLLER_NAME=Mauricare
PRIVACY_CONTROLLER_EMAIL=privacy@mauricare.mu
PRIVACY_DPO_EMAIL=privacy@mauricare.mu
PRIVACY_ACCOUNT_RETENTION_DAYS=30
PRIVACY_AUDIT_RETENTION_DAYS=2190

VITE_APP_NAME="${APP_NAME}"

DOCKER_RUN_MIGRATIONS=true
DOCKER_OPTIMIZE=true
